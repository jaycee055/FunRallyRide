{
  "rules": {
    ".read": false,
    ".write": false,
    "trips": {
      "$code": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('leaderId').val() === auth.uid && auth.token.email_verified === true) || (root.child('trips/'+$code+'/meta/leaderId').val() === auth.uid || root.child('trips/'+$code+'/members/'+auth.uid+'/role').val() === 'coleader'))",
          "leaderId": {
            ".validate": "!data.exists() || newData.val() === data.val()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "rules": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          }
        },
        "members": {
          ".read": "auth != null && data.child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && ((root.child('trips/'+$code+'/meta/leaderId').val() === auth.uid || root.child('trips/'+$code+'/members/'+auth.uid+'/role').val() === 'coleader') || (auth.uid === $uid && !newData.exists()) || (auth.uid === $uid && auth.token.email_verified === true && newData.child('role').val() === 'member' && !data.exists() && root.child('trips/'+$code+'/meta/club').exists() && root.child('clubs/'+root.child('trips/'+$code+'/meta/club').val()+'/members/'+auth.uid).exists() && !root.child('trips/'+$code+'/blocked/'+auth.uid).exists() && root.child('trips/'+$code+'/meta/status').val() !== 'ended' && root.child('trips/'+$code+'/meta/status').val() !== 'cancelled'))",
            "nick": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "bike": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            }
          }
        },
        "requests": {
          ".read": "auth != null && (root.child('trips/'+$code+'/meta/leaderId').val() === auth.uid || root.child('trips/'+$code+'/members/'+auth.uid+'/role').val() === 'coleader')",
          ".write": "auth != null && (root.child('trips/'+$code+'/meta/leaderId').val() === auth.uid || root.child('trips/'+$code+'/members/'+auth.uid+'/role').val() === 'coleader')",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && ((root.child('trips/'+$code+'/meta/leaderId').val() === auth.uid || root.child('trips/'+$code+'/members/'+auth.uid+'/role').val() === 'coleader') || (auth.uid === $uid && (!newData.exists() || (auth.token.email_verified === true && newData.child('status').val() === 'pending' && root.child('trips/'+$code+'/meta/locked').val() !== true && !root.child('trips/'+$code+'/blocked/'+auth.uid).exists() && (root.child('trips/'+$code+'/meta/status').val() === 'lobby' || root.child('trips/'+$code+'/meta/status').val() === 'live')))))",
            "nick": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "bike": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            }
          }
        },
        "state": {
          ".read": "auth != null && root.child('trips/'+$code+'/members/'+auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('trips/'+$code+'/members/'+auth.uid).exists()"
          }
        },
        "loc": {
          ".read": "auth != null && root.child('trips/'+$code+'/members/'+auth.uid).exists()",
          ".write": "auth != null && root.child('trips/'+$code+'/meta/leaderId').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && root.child('trips/'+$code+'/members/'+auth.uid).exists()) || (root.child('trips/'+$code+'/meta/leaderId').val() === auth.uid || root.child('trips/'+$code+'/members/'+auth.uid+'/role').val() === 'coleader'))"
          }
        },
        "presence": {
          ".read": "auth != null && root.child('trips/'+$code+'/members/'+auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "chat": {
          ".read": "auth != null && root.child('trips/'+$code+'/members/'+auth.uid).exists()",
          "$m": {
            ".write": "auth != null && root.child('trips/'+$code+'/members/'+auth.uid).exists() && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.child('t').isString() && newData.child('t').val().length <= 400"
          }
        },
        "alerts": {
          ".read": "auth != null && root.child('trips/'+$code+'/members/'+auth.uid).exists()",
          "$a": {
            ".write": "auth != null && root.child('trips/'+$code+'/members/'+auth.uid).exists() && (data.exists() ? data.child('uid').val() === auth.uid : newData.child('uid').val() === auth.uid)"
          }
        },
        "signal": {
          ".write": "auth != null && root.child('trips/'+$code+'/meta/leaderId').val() === auth.uid",
          "$to": {
            ".read": "auth != null && auth.uid === $to",
            ".write": "auth != null && auth.uid === $to",
            "$from": {
              ".write": "auth != null && auth.uid === $from && root.child('trips/'+$code+'/members/'+auth.uid).exists()"
            }
          }
        },
        "blocked": {
          ".read": "auth != null && (root.child('trips/'+$code+'/meta/leaderId').val() === auth.uid || root.child('trips/'+$code+'/members/'+auth.uid+'/role').val() === 'coleader')",
          ".write": "auth != null && (root.child('trips/'+$code+'/meta/leaderId').val() === auth.uid || root.child('trips/'+$code+'/members/'+auth.uid+'/role').val() === 'coleader')"
        },
        "stats": {
          ".read": "auth != null && root.child('trips/'+$code+'/members/'+auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('trips/'+$code+'/members/'+auth.uid).exists()"
          }
        },
        "track": {
          ".read": "auth != null && root.child('trips/'+$code+'/members/'+auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('trips/'+$code+'/members/'+auth.uid).exists()"
          }
        },
        "marks": {
          ".read": "auth != null && root.child('trips/'+$code+'/members/'+auth.uid).exists()",
          "$m": {
            ".write": "auth != null && root.child('trips/'+$code+'/members/'+auth.uid).exists() && (data.exists() ? data.child('uid').val() === auth.uid || (root.child('trips/'+$code+'/meta/leaderId').val() === auth.uid || root.child('trips/'+$code+'/members/'+auth.uid+'/role').val() === 'coleader') : newData.child('uid').val() === auth.uid)"
          }
        },
        "ec": {
          ".read": "auth != null && (root.child('trips/'+$code+'/meta/leaderId').val() === auth.uid || root.child('trips/'+$code+'/members/'+auth.uid+'/role').val() === 'coleader')",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('trips/'+$code+'/members/'+auth.uid).exists()",
            ".validate": "newData.child('p').isString() && newData.child('p').val().length <= 20"
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "nick": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 20"
        },
        "bike": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        }
      }
    },
    "myrides": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "clubs": {
      "$id": {
        ".write": "auth != null && root.child('clubs/'+$id+'/meta/ownerId').val() === auth.uid && !newData.exists()",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('ownerId').val() === auth.uid && auth.token.email_verified === true) || (data.exists() && root.child('clubs/'+$id+'/meta/ownerId').val() === auth.uid))",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          }
        },
        "members": {
          ".read": "auth != null && data.child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && ((root.child('clubs/'+$id+'/meta/ownerId').val() === auth.uid || root.child('clubs/'+$id+'/members/'+auth.uid+'/role').val() === 'admin') || (auth.uid === $uid && !newData.exists()) || (auth.uid === $uid && !data.exists() && newData.child('role').val() === 'owner' && root.child('clubs/'+$id+'/meta/ownerId').val() === auth.uid))",
            "nick": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            }
          }
        },
        "requests": {
          ".read": "auth != null && (root.child('clubs/'+$id+'/meta/ownerId').val() === auth.uid || root.child('clubs/'+$id+'/members/'+auth.uid+'/role').val() === 'admin')",
          ".write": "auth != null && (root.child('clubs/'+$id+'/meta/ownerId').val() === auth.uid || root.child('clubs/'+$id+'/members/'+auth.uid+'/role').val() === 'admin')",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && ((root.child('clubs/'+$id+'/meta/ownerId').val() === auth.uid || root.child('clubs/'+$id+'/members/'+auth.uid+'/role').val() === 'admin') || (auth.uid === $uid && (!newData.exists() || (auth.token.email_verified === true && newData.child('status').val() === 'pending'))))"
          }
        },
        "rides": {
          ".read": "auth != null && root.child('clubs/'+$id+'/members/'+auth.uid).exists()",
          "$code": {
            ".write": "auth != null && (root.child('clubs/'+$id+'/meta/ownerId').val() === auth.uid || root.child('clubs/'+$id+'/members/'+auth.uid+'/role').val() === 'admin')"
          }
        }
      }
    },
    "myclubs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}